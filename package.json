{
  "name": "nuestra-ia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages --outDir dist-pages",
    "lint": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "vite preview --mode pages --outDir dist-pages --host 127.0.0.1",
    "export:pages": "npm run build:pages && node scripts/export-pages.mjs",
    "data:update": "node scripts/run-r.mjs",
    "data:stats": "node scripts/run-r.mjs scripts/estadisticas.R",
    "data:crosses": "node scripts/run-r.mjs scripts/cruces.R"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.8.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
